{
  "libvirt_uri": "qemu:///system",
  "allow_writes": false,
  "read_only_uuids": [],
  "image_dirs": [
    "/var/lib/libvirt/images/templates"
  ],
  "disk_dirs": [
    "/var/lib/libvirt/images/vms",
    "/home/vm-disks"
  ],
  "storage_report_dir": "",
  "default_bridge": "br0",
  "default_network": "default",
  "default_network_type": "network",
  "static_network_defaults": {
    "br0": {
      "cidr": "192.168.0.0/24",
      "gateway": "192.168.0.1",
      "dns": ["192.168.0.1", "8.8.8.8"]
    }
  },
  "bridge_ip_discovery": false,
  "default_timezone": "Asia/Shanghai",
  "socket_path": "/run/vm-platform/agent.sock",
  "virsh": "virsh",
  "virt_install": "virt-install",
  "qemu_img": "qemu-img",
  "genisoimage": "",
  "max_vcpus": 256,
  "max_memory_gb": 1024,
  "max_disk_gb": 20000,
  "command_timeout": 120,
  "install_timeout": 3600
}
